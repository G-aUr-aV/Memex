{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'python3 \"$(git rev-parse --show-toplevel)/meta/tools/memex.py\" context'",
            "timeout": 15,
            "statusMessage": "Loading Memex context"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "apply_patch|Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'python3 \"$(git rev-parse --show-toplevel)/.claude/hooks/guard.py\"'",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
