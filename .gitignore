# The framework holds no knowledge. A vault created inside this folder (setup.sh's default when you run it
# from here) is its own local-only git repo and stays invisible to this one; setup.sh adds any other
# in-framework vault path to .git/info/exclude. The pre-commit hook and CI refuse these paths as well.
/MemexVault/
/wiki/
/raw/
/inbox/
/journal/
/notes/
/outputs/
/.memex/
/meta/
/Home.md
/Memex Manual.md
# Obsidian, if this folder is ever opened as a vault (open the vault folder instead)
/.obsidian/
.trash/
.DS_Store
.claude/settings.local.json
__pycache__/
*.pyc
