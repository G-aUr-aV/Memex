# Codex rules for the Memex vault (loaded when this project is trusted).
# allow = runs without a prompt (outside the sandbox); forbidden = never runs.
# Rendered from the Memex framework by `memex sync`; edit config/codex.rules.tmpl there, not here.
# Writes are still checked by the framework's hooks/guard.py (see .codex/hooks.json).

prefix_rule(
    pattern = ["python3", "{{MEMEX_PY}}"],
    decision = "allow",
    justification = "Memex CLI from the framework: writes stay inside the vault; pushes only to the owner's private remote",
)
prefix_rule(
    pattern = ["memex"],
    decision = "allow",
    justification = "Memex CLI (installed by setup.sh)",
)
